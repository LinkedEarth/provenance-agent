# Copy to .env at the root of the project you work in. Environment variables
# already exported win over anything set here.
#
# Only the agent layer (%provenance and agent.run) uses a model. The direct
# citation functions - cite_software() and cite_data() - need no API key.

# --- provider selection -------------------------------------------------------
# google (default) | openai | anthropic | ollama | xai   ("grok" also means xai)
# Every provider, including google, needs its extra installed:
#   pip install -e ".[google]"    pip install -e ".[openai]"
#   pip install -e ".[anthropic]" pip install -e ".[ollama]"
#   pip install -e ".[xai]"
# PROVENANCE_LLM_PROVIDER=google

# Override the provider's default model. The defaults are gemini-flash-latest,
# gpt-4o-mini, claude-sonnet-5, llama3.1, and grok-4 respectively.
# PROVENANCE_LLM_MODEL=

# --- credentials: set the one your provider needs -----------------------------
# These names match PaleoPAL's, so an existing PaleoPAL key works unchanged.
GOOGLE_API_KEY=replace_with_your_google_api_key
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# ollama runs locally and needs no key

# --- PaleoPAL interoperability ------------------------------------------------
# If PROVENANCE_LLM_PROVIDER is unset, PaleoPAL's DEFAULT_LLM_PROVIDER is used
# instead. PaleoPAL's model variables (OPENAI_MODEL, CLAUDE_MODEL, GOOGLE_MODEL,
# GROK_MODEL, OLLAMA_MODEL) are ignored on purpose: they default to heavyweight
# reasoning models, and the only call made here is one short classification.
