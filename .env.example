# Copy or rename this file to .env. Exported variables take precedence.
# cite_data() and cite_software() do not need an API key.

# Optional: google (default), openai, anthropic, ollama, or xai.
# PROVENANCE_LLM_PROVIDER=google
# PROVENANCE_LLM_MODEL=

# Set the key for your selected provider.
GOOGLE_API_KEY=replace_with_your_google_api_key
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# Ollama needs no key.

# Optional PaleoPAL fallback when PROVENANCE_LLM_PROVIDER is unset.
# DEFAULT_LLM_PROVIDER=
